<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Version>1.1.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PathMap>$(MSBuildProjectDirectory)=/_/media-suite</PathMap>
    <AssemblyName>MediaSuite</AssemblyName>
    <Product>Media Suite</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>MediaSuite.ico</ApplicationIcon>
    <EnableDefaultItems>false</EnableDefaultItems>
    <PublishSingleFile Condition="'$(SelfContained)' == 'true'">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs"/>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    <EmbeddedResource Include="browser/*" LogicalName="browser/%(Filename)%(Extension)"/>
    <EmbeddedResource Include="MediaSuite.ico" LogicalName="browser/favicon.ico"/>
    <InternalsVisibleTo Include="MediaSuite.BrowserSmoke"/>
  </ItemGroup>
</Project>
